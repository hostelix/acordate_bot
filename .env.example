# ========================================================
# CONFIGURACIÓN DE TELEGRAM
# ========================================================
# Token proporcionado por @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Tu ID de Telegram para restringir el bot solo a ti
# Puedes obtenerlo enviando cualquier mensaje a @userinfobot en Telegram
# Puedes poner varios separados por comas: 12345678,87654321
ALLOWED_USER_IDS=123456789

# ========================================================
# CONFIGURACIÓN DE HORARIOS Y ZONA HORARIA
# ========================================================
# Zona horaria (ej: America/La_Paz, America/Argentina/Buenos_Aires, America/Santiago, America/Bogota)
TIMEZONE=America/La_Paz

# Hora y minuto en los que se enviará la alerta preventiva diaria (formato 24h)
NOTIFICATION_HOUR=9
NOTIFICATION_MINUTE=0

# ========================================================
# CONFIGURACIÓN DE FIREBASE (Elige Opción A o B)
# ========================================================
# Opción A (Para desarrollo local con archivo descargado):
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# Opción B (Para desplegar en Koyeb: pega el contenido del archivo JSON como texto en una sola línea):
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ========================================================
# PUERTO PARA HEALTH CHECK DE KOYEB
# ========================================================
PORT=8000
